<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.8.0-alpha</Version>
    <Description>Experimental typed C# HDL verification using pinned cocotb native GPI adapters.</Description>
    <PackageLicenseExpression>MIT AND BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="SharpTestBench.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="licenses/" />
    <None Include="../../third_party/COCOTB-LICENSE" Pack="true" PackagePath="licenses/" />
    <None Include="../../native/*.*" Pack="true" PackagePath="native/" />
    <None Include="../../native/upstream/*.h" Pack="true" PackagePath="native/upstream/" />
    <None Include="../../third_party/UPSTREAM.json" Pack="true" PackagePath="native/" />
  </ItemGroup>

</Project>
